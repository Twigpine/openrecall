# ─── openrecall server config ──────────────────────────────────────────────
# The server is crypto-blind. None of these settings give it the ability to
# read memory contents — clients encrypt before upload.

PORT=8080

# ─── Storage driver ─────────────────────────────────────────────────────
# fs  — filesystem (zero-config; best for self-host / local dev)
# s3  — S3-compatible (Tigris, AWS, R2, minio; best for hosted)
# node — gitlawb node, one private repo per namespace (see the block below)
STORE=fs

# fs driver
DATA_DIR=./data

# s3 driver. Requires the Bun runtime: the adapter uses Bun's S3 client and has
# no Node equivalent, so STORE=s3 does not work from the Node build.
# S3_BUCKET=openrecall
# S3_ENDPOINT=https://fly.storage.tigris.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Auth ───────────────────────────────────────────────────────────────
# When true, no API key is required and everything maps to a single owner.
# Use for single-user self-host only. NEVER set true on a shared deployment.
ALLOW_UNAUTHENTICATED=true

# Hosted auth via the shared Twigpine Supabase (API-key lookup table).
# OPENRECALL_SUPABASE_URL=
# OPENRECALL_SUPABASE_SECRET_KEY=

# Simple static keys for self-host (comma-separated "owner:key" pairs).
# Example: STATIC_API_KEYS=alice:mk_live_aaa,bob:mk_live_bbb
# STATIC_API_KEYS=

# ─── Limits & quotas ────────────────────────────────────────────────────
MAX_ENTRY_BYTES=250000
MAX_ENTRIES_PER_NAMESPACE=2000
# Total ciphertext bytes per namespace.
MAX_NAMESPACE_BYTES=10000000
# Per-account (owner) aggregate caps. Not applied to the self-host `local`
# owner. Raise these for trusted/self-host deployments.
MAX_NAMESPACES_PER_OWNER=50
MAX_OWNER_BYTES=50000000
# Whole-PUT body cap (also enforced by the runtime, not just content-length).
MAX_BODY_BYTES=8000000

# ─── Rate limit (per owner, token bucket) ───────────────────────────────
# Set RATE_LIMIT_PER_MINUTE=0 to disable.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=240

# ─── Client (for the bundled CLI / MCP server — never sent to the server) ─
# Normally these live in ~/.openrecall/config.json (`openrecall init`); the
# env vars below override that file. OPENRECALL_HOME moves the directory.
#
# Passphrase the client derives the encryption key from. Keep this secret;
# losing it means losing access to your memory (zero-knowledge = no recovery
# by the host).
# OPENRECALL_PASSPHRASE=
# The passphrase may come from a file instead, and the file wins when both are
# set. A host that launches the MCP server spreads its own environment into
# every stdio child, so a passphrase exported for openrecall is readable by every
# other MCP server; a path is not.
# (absolute path)
# OPENRECALL_PASSPHRASE_FILE=/run/secrets/openrecall-passphrase
# "local" (default: encrypted store under ~/.openrecall/data, no server) or a
# server URL.
# OPENRECALL_URL=https://memory.twigpine.com
# OPENRECALL_API_KEY=
# Default namespace the MCP server reads/writes when a tool call omits one.
# OPENRECALL_NAMESPACE=user:me
# Secret-scan policy applied to plaintext before encryption: block|warn|off.
# OPENRECALL_SCAN=block
# How long any single request may take before the client gives up.
# OPENRECALL_TIMEOUT_MS=120000

# ── Node storage driver (STORE=node) ────────────────────────────────────
# Stores ciphertext in per-namespace private repos on a gitlawb node. Needs
# git, gl and git-remote-gitlawb on PATH; the shipped image carries them.
# GITLAWB_NODE_URL=http://localhost:7545
#
# Node storage will not start without this acknowledgement, because all three of
# the following are irreversible and none are visible from STORE=node alone:
#   1. Deleting an entry does not erase it. Prior ciphertext stays in git history.
#   2. Any pin or anchor already taken is permanent and cannot be retracted.
#   3. The only real erasure is destroying the passphrase, and that destroys
#      every namespace that owner holds, not the one entry you meant to remove.
# GITLAWB_NODE_ACKNOWLEDGE=true
# Path to the signing identity. The driver never reads the key itself; it
# passes the path to the git remote helper, which signs the push.
# GITLAWB_NODE_IDENTITY_PATH=/run/secrets/gitlawb-identity
#
# !! The store secret is NOT rotatable in place. !!
# It derives every repo name and the at-rest wrapping key, so changing it
# re-paths and re-wraps every namespace and needs the migration to run.
# Losing it orphans every node-stored namespace permanently: neither the repo
# name nor the wrapping key can be recovered from anything else. Disclosing it
# exposes manifest metadata (entry keys, sizes, timestamps) and confirms which
# namespaces exist; entry bodies stay client-encrypted and are not affected.
# Inject it at runtime, never bake it into an image layer, and custody it
# separately from the signing identity above. Back it up, and restore from that
# backup once to prove it works: an untested backup of this value is not a
# backup. To rotate, run scripts/node-store-migrate.ts, which re-paths and
# re-wraps each namespace; there is no in-place rotation.
# GITLAWB_NODE_STORE_SECRET=
